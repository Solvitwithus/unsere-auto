# ---- wb-server settings (copy to .env and fill in) ----

# PostgreSQL. With Neon use the *pooled* URL here; migrations automatically use
# the direct URL (same host without "-pooler"), or set DIRECT_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DIRECT_DATABASE_URL=

# Signs dashboard logins. 32+ random characters. Changing it signs everyone out.
# Generate: head -c 48 /dev/urandom | base64
JWT_SECRET=

# Where to listen. Behind nginx/Caddy keep it on 127.0.0.1.
BIND_ADDR=127.0.0.1:8080
# The built UI (web/out)
WEB_DIR=/opt/weighbridge/web
# Only needed when the UI is served from another origin (development)
# CORS_ORIGINS=http://localhost:3000

# ---- KRA eTIMS (optional) ----
# Your etims-rust server and an API key created in its dashboard (Admin > API keys).
# Leave empty to record sales without sending them to KRA.
ETIMS_URL=
ETIMS_API_KEY=
# Only if the API key can use several control units:
ETIMS_CONTROL_UNIT_ID=

# DB_MAX_CONNECTIONS=10
# RUST_LOG=info
